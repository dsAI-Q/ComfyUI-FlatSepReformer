{
  "1": {
    "class_type": "FlatSepReformerLoadAudio",
    "inputs": {
      "audio_path": "D:/path/to/your/mix_speech.wav"
    }
  },
  "2": {
    "class_type": "FlatSepReformerLoader",
    "inputs": {
      "model_dir": "",
      "backend": "modelscope",
      "device": "auto"
    }
  },
  "3": {
    "class_type": "FlatSepReformerSeparate",
    "inputs": {
      "model": ["2", 0],
      "audio": ["1", 0]
    }
  },
  "4": {
    "class_type": "FlatSepReformerSaveAudio",
    "inputs": {
      "audio": ["3", 0],
      "filename": "speaker_1",
      "output_dir": ""
    }
  },
  "5": {
    "class_type": "FlatSepReformerSaveAudio",
    "inputs": {
      "audio": ["3", 1],
      "filename": "speaker_2",
      "output_dir": ""
    }
  }
}
